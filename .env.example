# ──────────────────────────────────────────────────────────────
# Setu – Environment variable reference
# Copy this file to .env and fill in your own values.
# NEVER commit a real .env file.
# ──────────────────────────────────────────────────────────────

# ── API server ─────────────────────────────────────────────────
# Port the Express API listens on during local development.
PORT=4000

# Node runtime environment (development | production | test)
NODE_ENV=development

# ── Supabase (to be wired in a later task) ─────────────────────
# Project URL – safe to expose to the frontend.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Anonymous / public key – safe to expose to the frontend (read-only, RLS enforced).
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Service-role key – BACKEND ONLY, never expose to the frontend or commit.
# The Express API uses this to bypass RLS when accessing private tables.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Database connection (BACKEND ONLY) ─────────────────────────
# Postgres connection string used by the server-side pg connection pool.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# Supabase provides this in Project Settings → Database → Connection string.
# NEVER expose this in VITE_ variables or frontend code.
DATABASE_URL=postgresql://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres

# ── Vite / frontend (VITE_ prefix makes them accessible in the browser) ──
# These mirror the public Supabase values above for use in the React app.
# Do NOT add DATABASE_URL or service-role keys here.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
